# ---- Core ----
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://poet:poet@localhost:5432/poetry_hummus

# ---- Google OAuth ----
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must be: {PUBLIC_API_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Loyalty tuning ----
COINS_PER_SHEKEL=1
SIGNUP_BONUS_COINS=20

# ---- Bootstrap admin (created on first startup if set) ----
BOOTSTRAP_ADMIN_EMAIL=admin@hummushameshorer.com
BOOTSTRAP_ADMIN_PASSWORD=
