# ===========================================================================
#  חומוס המשורר — environment configuration
#
#  Settings live in app/configuration/main.py (pydantic-settings). Each group
#  has a POETRY_<GROUP>__<FIELD> name; the short names below are kept as
#  aliases for convenience. Copy to .env and fill in.
#
#  In Kubernetes these are set by the Helm chart — see
#  deploy/helm/poetry-hummus/values.yaml.
# ===========================================================================

# ---- Core ----
APP_ENV=development
FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# ---- Database (POETRY_DB__*) ----
# Defaults to the local dev database if unset.
DATABASE_URL=postgresql+asyncpg://poet:poet@localhost:5432/poetry_hummus
# POETRY_DB__POOL_SIZE=5
# POETRY_DB__MAX_OVERFLOW=10
# POETRY_DB__ECHO_SQL=false

# ---- Security (POETRY_SECURITY__*) ----
# Signs session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-long-random-string

# ---- Google OAuth (POETRY_GOOGLE__*) ----
# https://console.cloud.google.com/apis/credentials
# Redirect URI must be exactly {PUBLIC_API_URL}/api/auth/google/callback
# Leave Authorized JavaScript origins empty — the flow is server-side.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Loyalty (POETRY_LOYALTY__*) ----
COINS_PER_SHEKEL=1
SIGNUP_BONUS_COINS=20

# ---- Bootstrap admin (POETRY_ADMIN__*) ----
# Created on first startup when both are set.
BOOTSTRAP_ADMIN_EMAIL=admin@hummushameshorer.com
BOOTSTRAP_ADMIN_PASSWORD=
