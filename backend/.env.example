# ===========================================================================
#  חומוס המשורר — environment configuration
#
#  Settings live in backend/app/configuration/main.py (pydantic-settings).
#  Names follow the groups there: POETRY_<GROUP>__<FIELD>.
#
#  Short legacy names (DATABASE_URL, SECRET_KEY…) still work as aliases, but
#  a canonical POETRY_* value always wins over its alias — so prefer these.
#
#  In Kubernetes the same variables are set by the Helm chart; credentials
#  come from a Secret. See deploy/helm/poetry-hummus/values.yaml.
#
#  Copy to .env and fill in. .env is gitignored — keep it that way.
# ===========================================================================

# ---- Core ----
POETRY_APP_ENV=development
POETRY_FRONTEND_URL=http://localhost:5173
POETRY_PUBLIC_API_URL=http://localhost:8000

# ---- Database (POETRY_DB__*) ----
# Falls back to the local dev database when unset.
POETRY_DB__URL=postgresql+asyncpg://poet:poet@localhost:5432/poetry_hummus
# POETRY_DB__POOL_SIZE=5
# POETRY_DB__MAX_OVERFLOW=10
# POETRY_DB__ECHO_SQL=false

# ---- Security (POETRY_SECURITY__*) ----
# Signs session JWTs. REQUIRED in production — the app refuses to start
# without it. Unset in development, a random key is generated per process,
# so sessions do not survive a restart.
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
POETRY_SECURITY__SECRET_KEY=

# ---- Google OAuth (POETRY_GOOGLE__*) ----
# https://console.cloud.google.com/apis/credentials  (type: Web application)
# Authorized redirect URI, exactly:
#   {POETRY_PUBLIC_API_URL}/api/auth/google/callback
# Leave "Authorized JavaScript origins" empty — the flow is server-side.
# Blank here simply hides the member Google button; admin login still works.
POETRY_GOOGLE__CLIENT_ID=
POETRY_GOOGLE__CLIENT_SECRET=

# ---- Loyalty (POETRY_LOYALTY__*) ----
POETRY_LOYALTY__COINS_PER_SHEKEL=1
POETRY_LOYALTY__SIGNUP_BONUS_COINS=5

# ---- Bootstrap admin (POETRY_ADMIN__*) ----
# The first admin, created on startup when both are set. Changing the
# password here does not update an admin that already exists.
POETRY_ADMIN__EMAIL=admin@hummushameshorer.com
POETRY_ADMIN__PASSWORD=
